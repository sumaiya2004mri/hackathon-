# Gemini API key (free tier) — powers the AI pass and image analysis.
# Get one at https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# Firebase project config — from Firebase console > Project settings.
# The app works fully in guest mode without these; only needed for
# persistent accounts / cross-device history.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=
